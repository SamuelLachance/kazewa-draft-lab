# Variables du serveur uniquement. Ne jamais copier un secret dans public/.
PORT=4173
FRONTEND_ORIGIN=http://localhost:4173
# Source publique expérimentale, sans clé ; compositions disponibles en partie.
LIVE_PROVIDER=lolesports
# Flux normalisé HTTPS conforme à docs/LIVE_SOURCES.md :
LIVE_FEED_URL=
LIVE_FEED_TOKEN=
# Ou connecteur PandaScore (abonnement live nécessaire) :
PANDASCORE_TOKEN=
# Construction GitHub Pages : URL PUBLIQUE du proxy, sans token.
LIVE_API_URL=
