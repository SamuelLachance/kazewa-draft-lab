{
  "name": "kazewa-draft-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Jugement de drafts League of Legends fondé sur le corpus Kazewa, avec suivi professionnel via un flux serveur.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/server.mjs --public-live",
    "start": "node server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "knowledge": "node scripts/build-knowledge.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "distill": "node scripts/distill.mjs",
    "sync:champions": "node scripts/sync-champions.mjs",
    "verify:fidelity": "node scripts/verify-fidelity.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run test && npm run build"
  }
}
