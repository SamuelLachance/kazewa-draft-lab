{
  "name": "kazewa-draft-lab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Verdicts de Kazewa sur les drafts League of Legends qu’il a commentées, et lecture mesurée des drafts inédites.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/server.mjs --public-live",
    "start": "node server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "knowledge": "node scripts/build-knowledge.mjs",
    "oe:index": "node scripts/build-oe-index.mjs",
    "memory": "node scripts/build-memory.mjs",
    "pro:results": "node scripts/build-pro-results.mjs",
    "coach:data": "node scripts/build-coach-data.mjs",
    "method": "node scripts/build-method.mjs",
    "memory:enrich": "node scripts/import-enrichment.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "sync:champions": "node scripts/sync-champions.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run test && npm run evaluate && npm run build"
  }
}
